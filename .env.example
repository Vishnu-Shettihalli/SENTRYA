VITE_FIREBASE_API_KEY="AIzaSyBmgVnoTni7sLNEedf9xbtSX5cjEkDKfdY"
VITE_FIREBASE_AUTH_DOMAIN="sentrya-ef064.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="sentrya-ef064"
VITE_FIREBASE_STORAGE_BUCKET="sentrya-ef064.firebasestorage.app"
